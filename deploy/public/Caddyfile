{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    encode gzip zstd
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    @health path /healthz
    handle @health {
        respond "ok" 200
    }
    @private path /api /api/* /.env /.git/* /accounts.html /connexion.html /admin.html
    handle @private {
        respond 404
    }
    handle {
        root * /srv/public
        file_server
    }
}
