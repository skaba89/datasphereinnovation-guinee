{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    encode gzip zstd
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy same-origin
    }
    @health path /healthz
    handle @health {
        respond "ok" 200
    }
    @private path /api /api/* /.env /.git/* /accounts.html /connexion.html /admin.html
    handle @private {
        respond 404
    }
    handle {
        root * /srv/public
        file_server
    }
}
