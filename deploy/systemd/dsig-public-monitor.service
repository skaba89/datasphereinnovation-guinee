[Unit]
Description=DSIG public HTTPS monitoring
After=network-online.target
Wants=network-online.target
OnFailure=dsig-public-alert.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/datasphereinnovation-guinee
ExecStart=/usr/bin/python3 /home/ubuntu/datasphereinnovation-guinee/scripts/monitor-public.py
TimeoutStartSec=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077
StandardOutput=journal
StandardError=journal
