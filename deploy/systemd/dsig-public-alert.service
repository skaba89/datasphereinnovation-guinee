[Unit]
Description=DSIG public incident notification

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/dsig-public-alert.env
ExecStart=/usr/bin/python3 /home/ubuntu/datasphereinnovation-guinee/scripts/notify-public.py
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
UMask=0077
