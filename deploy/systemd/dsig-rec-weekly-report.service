[Unit]
Description=DSIG REC weekly management report
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/datasphereinnovation-guinee
ExecStart=/bin/sh -c 'docker compose -p dsig-rec -f compose.yaml -f compose.rec-edge.yaml -f compose.rec-clamav.yaml exec -T dsig python server.py --send-weekly-report < /etc/dsig-rec-report.json'
TimeoutStartSec=180
