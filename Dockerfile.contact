# DSIG PROD contact service: only the public contact endpoint, no REC code (V174).
FROM python:3.12-slim
WORKDIR /app
RUN groupadd -g 10001 dsig && useradd -u 10001 -g dsig -M dsig && mkdir -p /data && chown dsig:dsig /data
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt
COPY contact_form.py contact_service.py /app/
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 DSIG_CONTAINER=1 DSIG_CONTACT_DB=/data/contact.sqlite3
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/healthz', timeout=3).read()"]
CMD ["python", "contact_service.py"]
