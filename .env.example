DSIG_ENV=REC
DSIG_PORT=8080
# Generate a private random value before launch. Never commit the actual value.
DSIG_ADMIN_TOKEN=
# Generate once and retain securely; required for MFA enrollment and verification.
DSIG_MFA_KEY=
# Independent Fernet key for encrypted backups; keep separately and securely.
DSIG_BACKUP_KEY=
# Independent Fernet key for private PDF documents.
DSIG_DOCUMENT_KEY=
# Temporary previous key for documented rotation only; never commit the value.
DSIG_DOCUMENT_PREVIOUS_KEY=
# Required for PDF upload/download: absolute private clamd Unix socket path.
DSIG_CLAMD_SOCKET=
# ADMIN is always mandatory; other sensitive roles default to those below.
DSIG_MFA_REQUIRED_ROLES=DIRECTION,CONTROLE,COMPTABLE,AUDITEUR
